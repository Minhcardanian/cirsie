{
  "name": "ledger-zkir-explorer",
  "version": "0.3.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vscode/vsce": "^4.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "displayName": "ZKIR Explorer",
  "icon": "extension/logo.png",
  "description": "Inspect and compare Midnight ZKIR circuits locally.",
  "publisher": "local-zkir",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension/extension.cjs",
  "activationEvents": [
    "onCommand:zkirExplorer.open",
    "onWebviewPanel:zkirGraph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zkirExplorer.open",
        "title": "ZKIR Explorer: Open Baseline"
      },
      {
        "command": "zkirExplorer.openFile",
        "title": "ZKIR Explorer: Open as Baseline"
      },
      {
        "command": "zkirExplorer.compare",
        "title": "ZKIR Explorer: Compare with Candidate"
      },
      {
        "command": "zkirExplorer.examples",
        "title": "ZKIR Explorer: Load Example Baseline"
      },
      {
        "command": "zkirExplorer.complexExample",
        "title": "ZKIR Explorer: Load Complex Example"
      },
      {
        "command": "zkirExplorer.graph",
        "title": "ZKIR Explorer: Show Dependency Graph"
      },
      {
        "command": "zkirExplorer.exportJson",
        "title": "ZKIR Explorer: Export Analysis JSON"
      },
      {
        "command": "zkirExplorer.exportMarkdown",
        "title": "ZKIR Explorer: Export Comparison Markdown"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zkirExplorerContainer",
          "title": "ZKIR Explorer",
          "icon": "extension/icon.svg"
        }
      ]
    },
    "views": {
      "zkirExplorerContainer": [
        {
          "id": "zkirExplorerView",
          "name": "Circuit Inspector"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zkirExplorerView",
        "contents": "Open a ZKIR circuit to inspect its instructions.\n[Open baseline](command:zkirExplorer.open)\n[Load example](command:zkirExplorer.examples)\n[Load complex example](command:zkirExplorer.complexExample)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zkirExplorer.open",
          "when": "view == zkirExplorerView",
          "group": "navigation"
        },
        {
          "command": "zkirExplorer.compare",
          "when": "view == zkirExplorerView",
          "group": "navigation"
        },
        {
          "command": "zkirExplorer.graph",
          "when": "view == zkirExplorerView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "zkirExplorer.openFile",
          "when": "resourceExtname == .zkir",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ZKIR Explorer",
      "properties": {
        "zkirExplorer.maxArtifactBytes": {
          "type": "integer",
          "default": 4194304,
          "minimum": 1024,
          "maximum": 16777216,
          "scope": "application",
          "description": "Maximum size in bytes of an imported ZKIR artifact."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Minhcardanian/cirsie.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
