{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" },
    { "name": "%c.2", "type": "Scalar<BLS12-381>" },
    { "name": "%d.3", "type": "Scalar<BLS12-381>" },
    { "name": "%chooseLeft.4", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_to_boolean", "val": "%chooseLeft.4" },
    { "op": "mul", "output": "%firstProduct.5", "a": "%a.0", "b": "%b.1" },
    { "op": "mul", "output": "%secondProduct.6", "a": "%c.2", "b": "%d.3" },
    { "op": "add", "output": "%shared.7", "a": "%firstProduct.5", "b": "%secondProduct.6" },
    { "op": "mul", "output": "%t.8", "a": "%shared.7", "b": "%a.0" },
    { "op": "add", "output": "%left.9", "a": "%t.8", "b": "%c.2" },
    { "op": "mul", "output": "%t.10", "a": "%shared.7", "b": "%d.3" },
    { "op": "add", "output": "%right.11", "a": "%t.10", "b": "%b.1" },
    { "op": "mul", "output": "%cross.12", "a": "%left.9", "b": "%right.11" },
    { "op": "add", "output": "%total.13", "a": "%left.9", "b": "%right.11" },
    { "op": "mul", "output": "%t.14", "a": "%shared.7", "b": "%shared.7" },
    { "op": "add", "output": "%check.15", "a": "%t.14", "b": "%cross.12" },
    { "op": "cond_select", "output": "%tmp.16", "bit": "%chooseLeft.4", "a": "%left.9", "b": "%right.11" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "-0x02", "%tmp.16"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "-0x02", "%total.13"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "-0x02", "%check.15"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] }
  ]
}
